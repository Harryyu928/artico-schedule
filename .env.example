# ARTDiCO 教务系统环境变量配置示例
# 复制此文件为 .env.local 并填入实际值

# ==================== 数据库配置 ====================
# Supabase PostgreSQL 数据库连接字符串
# 格式: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=
SUPABASE_DB_URL=

# ==================== 飞书集成配置（可选）====================
# 如果要启用飞书集成，请填写以下配置
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=

# ==================== 系统配置 ====================
# 开发环境设置为 DEV，生产环境设置为 PROD
NODE_ENV=development
COZE_PROJECT_ENV=DEV

# ==================== 说明 ====================
# 1. 如果暂时没有数据库，系统会使用模拟数据运行
# 2. 数据库配置可以从 Supabase 项目设置中获取
# 3. 飞书集成配置可以从飞书开放平台获取
